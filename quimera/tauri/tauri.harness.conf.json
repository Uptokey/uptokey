{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uptokey",
  "version": "0.2.0",
  "identifier": "com.uptokey.tauri",
  "build": {
    "features": ["harness-entry"],
    "beforeDevCommand": null,
    "beforeBuildCommand": {"script":"node scripts/frontend-hook.mjs harness","cwd":"."},
    "devUrl": null,
    "frontendDist": "../../experiments/deepseek-workbench/desktop/assets"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [
        "harness-account",
        "harness-theme",
        "harness-public-api",
        "harness-notification",
        "harness-computer-focus"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/sidecar/"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "macOS": {},
    "linux": {
      "deb": {
        "depends": [
          "ca-certificates",
          "default-dbus-session-bus | dbus-session-bus",
          "libsecret-1-0",
          "podman",
          "libc6 (>= 2.39)",
          "libgcc-s1 (>= 4.2)",
          "libstdc++6 (>= 10.2)",
          "libxcb1 (>= 1.11.1)",
          "libcairo2 (>= 1.10.0)",
          "libdbus-1-3 (>= 1.10)",
          "libgdk-pixbuf-2.0-0 (>= 2.36.9)",
          "libglib2.0-0t64 (>= 2.66.0)",
          "libgtk-3-0t64 (>= 3.21.5)",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0 (>= 3.0.3)",
          "libwebkit2gtk-4.1-0 (>= 2.41.90)",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "recommends": ["gnome-keyring"]
      }
    }
  }
}
