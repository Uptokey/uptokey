{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uptokey",
  "version": "0.2.0",
  "identifier": "com.uptokey.tauri",
  "build": {
    "beforeDevCommand": { "script": "node scripts/frontend-hook.mjs dev", "cwd": ".", "wait": false },
    "beforeBuildCommand": { "script": "node scripts/frontend-hook.mjs build", "cwd": "." },
    "frontendDist": "../uptokey/uptokey-pwa/dist",
    "devUrl": "http://127.0.0.1:5273"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Uptokey",
        "url": "/design/#work",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:21435 ws://127.0.0.1:21435; worker-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
  
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/sidecar/"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Portuguese"]
      }
    },
    "macOS": {},
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
