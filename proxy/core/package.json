{
  "name": "@uptokey/proxy-local",
  "version": "0.1.0-beta.14",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "uptokey": "dist/cli.js"
  },
  "scripts": {
    "test": "node scripts/test-isolated.mjs",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:bun": "bun test test",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --project tsconfig.core.json --noEmit",
    "typecheck:core": "node ./node_modules/typescript/lib/tsc.js --project tsconfig.core.json --noEmit",
    "typecheck:opentui": "node ./node_modules/typescript/lib/tsc.js --noEmit -p src/tui/frontend/tsconfig.json",
    "typecheck:opentui-strict": "node scripts/check-opentui-strict.mjs",
    "test:integration-renderer": "node scripts/test-integration-required.mjs renderer",
    "test:integration-artifact": "node scripts/test-integration-required.mjs artifact",
    "build": "node scripts/build-npm-package.mjs",
    "build:tui": "node scripts/build-tui-frontend.mjs",
    "verify:tui": "node scripts/verify-tui-frontend.mjs && node scripts/verify-tui-parser.mjs",
    "verify:tui-parser": "node scripts/verify-tui-parser.mjs",
    "test:tui-frontend": "node --experimental-strip-types scripts/tui-frontend-pty.mjs",
    "benchmark:tui-frontend": "node --experimental-strip-types scripts/tui-frontend-bench.mjs",
    "prepack": "npm run build && npm run build:tui",
    "start": "node dist/cli.js start",
    "doctor": "node dist/cli.js doctor",
    "benchmark:local": "node scripts/benchmark-local-runtime.mjs",
    "verify:beta": "node scripts/verify-beta-artifact.mjs",
    "acceptance:windows-clean": "node scripts/windows-clean-acceptance.mjs",
    "pack:beta": "node scripts/beta-build-candidate.mjs",
    "tui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types src/cli.ts tui",
    "forge": "node --experimental-strip-types src/cli.ts forge",
    "code": "node --experimental-strip-types src/cli.ts code",
    "test:tui": "node --experimental-strip-types --test test/tui-core.test.ts test/tui-editor.test.ts test/tui-diff.test.ts test/tui-auth.test.ts test/tui-highlight.test.ts test/tui-sanitize.test.ts test/tui-acceptance.test.ts test/tui-perf.test.ts test/tui-improvements.test.ts test/tui-features2.test.ts test/tui-editor-authority.test.ts test/tui-audience.test.ts test/tui-tool-plans.test.ts test/tui-b4-improvements.test.ts test/tui-innovations.test.ts test/tui-innovations-2.test.ts test/tui-b4-recovery.test.ts test/tui-f0-security.test.ts test/tui-v2-input.test.ts test/tui-v2-units.test.ts test/tui-editor-session.test.ts test/tui-frontend-launcher.test.ts test/tui-cli-route.test.ts test/tui-command-aliases.test.ts",
    "test:tui-integrated": "node --experimental-strip-types --test test/tui-core.test.ts test/tui-editor.test.ts test/tui-diff.test.ts test/tui-auth.test.ts test/tui-highlight.test.ts test/tui-sanitize.test.ts test/tui-acceptance.test.ts test/tui-perf.test.ts test/tui-improvements.test.ts test/tui-features2.test.ts test/tui-integration.test.ts test/tui-editor-authority.test.ts test/tui-audience.test.ts test/tui-tool-plans.test.ts test/tui-b4-improvements.test.ts test/tui-innovations.test.ts test/tui-innovations-2.test.ts test/tui-b4-recovery.test.ts test/tui-transport-boundary.test.ts test/tui-f0-security.test.ts test/tui-v2-input.test.ts test/tui-v2-units.test.ts test/tui-editor-session.test.ts test/tui-frontend-launcher.test.ts test/tui-cli-route.test.ts test/tui-command-aliases.test.ts",
    "test:tui-e2e": "node --experimental-strip-types --test test/tui-transport-boundary.test.ts test/tui-integration.test.ts",
    "benchmark:tui": "node --experimental-strip-types --test test/tui-perf.test.ts",
    "test:tui-journeys": "node --experimental-strip-types scripts/tui-frontend-pty.mjs boot chat connect edit commands folder scroll copy temporary sessions switch-project",
    "setup:debugger": "node scripts/setup-debugger.mjs",
    "test:tui-pack-linux": "node scripts/pack-and-verify-linux.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hpke/core": "^1.9.0",
    "@langchain/core": "1.2.11",
    "@langchain/langgraph": "1.4.15",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@langchain/langgraph-sdk": "1.11.0",
    "@langchain/protocol": "0.0.19",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.4",
    "@lezer/javascript": "1.5.5",
    "@lezer/json": "1.0.3",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "^1.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/otlp-exporter-base": "0.222.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "@repomix/tree-sitter-wasms": "^0.1.17",
    "@simplewebauthn/server": "^13.3.2",
    "@types/diff-match-patch": "^1.0.36",
    "@uptokey/sync-contract": "file:./vendor/sync-contract",
    "better-sqlite3": "12.11.1",
    "diff": "8.0.4",
    "diff-match-patch": "^1.0.5",
    "eventsource-parser": "4.1.0",
    "hono": "4.13.13",
    "ipaddr.js": "1.9.1",
    "js-tiktoken": "1.0.21",
    "langsmith": "0.10.3",
    "oauth4webapi": "3.8.8",
    "pngjs": "7.0.0",
    "tar-stream": "2.2.0",
    "tree-sitter-wasm": "2.0.2",
    "undici": "7.30.0",
    "web-tree-sitter": "^0.27.0",
    "ws": "8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/tar-stream": "3.1.4",
    "@types/ws": "8.18.1",
    "@xterm/headless": "6.0.0",
    "bun": "^1.4.0",
    "openai": "7.23.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.2.0"
  },
  "description": "Terminal coding assistant and local BYOK API (127.0.0.1:21435/v1) with an OS secret store",
  "main": "dist/cli.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "FIRST-RUN-BETA.md",
    "SPEC-MCP-V1.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "overrides": {
    "zod": "^3.25.76"
  }
}
