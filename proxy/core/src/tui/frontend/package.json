    "@opentui/solid": "0.4.5",
    "clipboardy": "4.0.0",
    "diff": "8.0.4",
    "effect": "4.0.0-beta.83",
    "fuzzysort": "3.1.0",
    "opentui-spinner": "0.0.7",
    "remeda": "2.26.0",
    "solid-js": "1.9.10",
    "strip-ansi": "7.1.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "5.8.2"
  }
}
