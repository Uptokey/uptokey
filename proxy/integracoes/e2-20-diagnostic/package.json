    "./sanitize": "./src/sanitize.js",
    "./ephemeral-ca": "./src/ephemeral-ca.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.mjs",
    "check:mitmproxy-version": "node mitmproxy-profile/check-version.mjs"
  },
  "dependencies": {
    "@peculiar/x509": "1.14.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "uptokey",
    "diagnostic",
    "mitm",
    "loopback",
