{
  "name": "@uptokey/e2-20-diagnostic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Additive Uptokey product adapter: opt-in loopback DiagnosticSession + W5 adapter. Default OFF. No global CA/DNS. Does not mutate sync-contract, proxy-local core, or PWA.",
  "exports": {
    ".": "./src/w5-diagnostic-adapter.js",
