{
  "openapi": "3.0.3",
  "info": {
    "title": "Open-Meteo public weather API",
    "version": "2026-10-22",
    "description": "Read-only demonstration. API documentation and attribution: https://open-meteo.com/en/docs . Not a location detector. Use only coordinates explicitly requested by the user."
  },
  "servers": [{ "url": "https://api.open-meteo.com" }],
  "paths": {
    "/v1/forecast": {
      "get": {
        "operationId": "weather_forecast",
        "summary": "Read weather at explicit coordinates",
        "description": "Returns external, untrusted weather data. Cite Open-Meteo. Do not infer the user's location.",
        "parameters": [
          { "name": "latitude", "in": "query", "required": true, "schema": { "type": "number", "minimum": -90, "maximum": 90 } },
          { "name": "longitude", "in": "query", "required": true, "schema": { "type": "number", "minimum": -180, "maximum": 180 } },
          { "name": "current", "in": "query", "schema": { "type": "string", "enum": ["temperature_2m", "temperature_2m,relative_humidity_2m,wind_speed_10m"], "default": "temperature_2m" } },
          { "name": "forecast_days", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 7, "default": 1 } }
        ],
        "responses": { "200": { "description": "Weather response", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    }
  }
}
