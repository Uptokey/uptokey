FROM docker.io/library/node:24.22.1-bookworm-slim@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c
LABEL io.uptokey.workspace="encrypted-tmpfs-v1"
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ ca-certificates ripgrep procps && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/harness
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi
COPY integrations/package*.json /opt/integrations/
RUN cd /opt/integrations && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi
COPY apis/ /opt/harness/apis/
