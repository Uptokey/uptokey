RUN node --test /opt/harness/extensions/request-image-cache.test.mjs
RUN node --test /opt/harness/extensions/encrypted-images.test.mjs
RUN node --test /opt/harness/extensions/generic-secretstream.test.mjs /opt/harness/extensions/encrypted-files.test.mjs /opt/harness/extensions/materialization-paths.test.mjs
RUN node --test /opt/harness/extensions/encrypted-workspace.test.mjs
RUN node --test /opt/harness/extensions/encrypted-export.test.mjs
