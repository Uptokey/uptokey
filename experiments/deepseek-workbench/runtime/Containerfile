RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core fonts-liberation2 && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server && rm -rf /var/lib/apt/lists/* && mkdir -p /run/sshd && usermod -p '*' node
COPY sshd_config /opt/harness/sshd_config
COPY contracts/ /opt/harness/contracts/
COPY extensions/materialization-ownership.mjs /opt/harness/extensions/materialization-ownership.mjs
COPY execution/ /opt/harness/execution/
RUN node --test /opt/harness/execution/image-path.test.mjs
RUN node --test /opt/harness/execution/subprocess-ownership.test.mjs
RUN node --test /opt/harness/execution/filesystem-ownership.test.mjs
RUN mkdir -p /workspace /home/node/.dsh/attachments /opt/harness/demo && chown -R node:node /workspace /home/node /opt/harness/demo
COPY --chown=node:node demo/ /opt/harness/demo/
COPY entry.mjs browse-picker.yml /opt/harness/
COPY account/ /opt/harness/account/
COPY branding/ /opt/harness/branding/
COPY integrations/computer-focus-client.mjs /opt/harness/integrations/computer-focus-client.mjs
RUN node --test /opt/harness/branding/automation-approval.test.mjs
RUN node --test /opt/harness/branding/lifecycle-notifications.test.mjs
RUN node --test /opt/harness/branding/plugin-trust-approval.test.mjs /opt/harness/branding/plugin-boundary-patch.test.mjs /opt/harness/branding/explicit-approval-patch.test.mjs
RUN node /opt/harness/branding/apply.mjs
RUN node /opt/harness/branding/plugin-boundary-runtime-smoke.mjs
COPY extensions/ /opt/harness/extensions/
RUN node --test /opt/harness/extensions/materialization-ownership.test.mjs
RUN node --test /opt/harness/extensions/materialization-eviction.test.mjs
RUN node --test /opt/harness/extensions/attachment-preview.test.mjs
RUN node --test /opt/harness/extensions/post-edit-verification.test.mjs
RUN node --test /opt/harness/extensions/local-discovery.test.mjs
RUN node --test /opt/harness/extensions/api-file-registry.test.mjs
RUN node --test /opt/harness/extensions/credentials.test.mjs /opt/harness/extensions/durable-changes.test.mjs /opt/harness/extensions/api-file-pipeline.test.mjs
RUN node --test /opt/harness/extensions/hosted-adapter.test.mjs /opt/harness/extensions/hosted-native.test.mjs /opt/harness/extensions/hosted-response.test.mjs
RUN node --test /opt/harness/extensions/encrypted-sessions-store.test.mjs /opt/harness/extensions/encrypted-sessions.test.mjs
