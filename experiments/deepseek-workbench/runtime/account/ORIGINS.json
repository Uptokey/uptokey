  "privateConfigurationImported": false,
  "adaptations": [
    "Explicit rail lifecycle instead of auto-mount",
    "LocalAccount HTTP boundary replaced with narrow native IPC; validation and authorization remain canonical",
    "No-secret getLocalToken presence marker for canonical local controls",
    "One persistent ConnectedAccount instance with null headless presentation; avatar invokes original login handler without opening Account",
    "Validated challenge handed to existing pending lifecycle before opener; opener errors preserved and cancellation revalidated",
    "Canonical validated pending login URL retained for explicit reopen after status, binding and expiry checks; no second challenge",
    "Compact explicit Account/Usage presentation and original Harness Toast for headless errors",
    "Canonical provider setup protocol copied byte-for-byte for the Harness native transport"
  ],
  "mounted": false,
  "catalogRevalidation": {
    "binding": "Canonical accountBindingRevision/subscribeAccountBinding, unchanged",
    "refresh": "Canonical subscribeInteractionRefresh account graph, unchanged",
    "purpose": "Invalidate the original model directory after account input changes; no login, credential or authorization mutation"
  }
}
